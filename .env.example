# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# Neon — two strings from the same project, and they are not interchangeable.
#   POOLED  : host contains "-pooler". Used by the API at runtime. Serverless
#             functions open a connection per invocation, so one lab section of
#             35 students exhausts the direct connection limit without this.
#   DIRECT  : no "-pooler". Used only by drizzle-kit for migrations, which need
#             a session-level connection that the pooler will not give.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Better Auth (Phase 3). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Resend (Phase 3) — verification and password-reset email.
RESEND_API_KEY=
EMAIL_FROM="Breadboard Trainer <noreply@example.edu>"

# Instructor sign-up gate (Phase 3). Without this, anyone can register as
# faculty and read every golden netlist.
INSTRUCTOR_INVITE_CODE=

# Cloudflare R2 (Phase 6) — schematic uploads. The browser only ever receives a
# presigned URL; these credentials stay server-side.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Local API port. Vite proxies /api here in development.
API_PORT=3001

# ---------------------------------------------------------------------------
# Local session impersonation (Phase 2 only). Delete once Phase 3 lands.
#
# With no Better Auth yet, the session resolver has no way to prove who is
# calling, so every protected route answers 401. Setting DEV_AUTH=1 installs a
# development provider that reads a profile id from the `x-dev-user` request
# header, or from DEV_AUTH_USER when the header is absent.
#
# It invents nothing — the id is looked up in `profiles`, and an unknown one is
# still 401. It also refuses to start on NODE_ENV=production or on any Vercel
# deployment, preview included, so it cannot follow this file into a real
# environment.
#
#   npm run db:seed
#   DEV_AUTH=1 npm run dev:api
#   curl -H "x-dev-user: seed_student_cruz" http://127.0.0.1:3001/api/exercises
DEV_AUTH=
DEV_AUTH_USER=

# Response scan that blocks a golden netlist reaching a student, as defence in
# depth behind the column projections. On unless set to 0.
API_GOLDEN_NETLIST_TRIPWIRE=

# AI Coach (build plan v1.2/v1.3) — an open-weight Qwen model, self-hosted with
# Ollama or vLLM, reached through an OpenAI-compatible /chat/completions
# endpoint. Server-side only; none of these may ever reach the browser.
#
# Leave COACH_BASE_URL empty and the coach is simply off: after-submit feedback
# is the deterministic catalogue text, and nothing else changes.
#
#   COACH_BASE_URL   the base including /v1 — http://localhost:11434/v1 (Ollama),
#                    http://gpu-box:8000/v1 (vLLM)
#   COACH_MODEL      the model tag the server serves, e.g. qwen3:8b
#   COACH_API_KEY    optional; sent as a Bearer token when set
#   COACH_TIMEOUT_MS how long a submit waits for wording before falling back
COACH_BASE_URL=
COACH_MODEL=qwen3:8b
COACH_API_KEY=
COACH_TIMEOUT_MS=8000
